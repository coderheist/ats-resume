# Environment
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local database
dev.db
*.sqlite3

# Node dependencies -- unqualified so a package.json added at any
# level (not just frontend-react/) can never drag node_modules into a commit.
node_modules/
frontend-react/node_modules/
frontend-react-dist/

# Build output. frontend-react-dist/ (above) is where vite actually writes;
# frontend-react/dist/ is the copy frontend-react/vercel.json makes so the
# output sits inside Vercel's Root Directory -- see that file's comment in
# docs/DEPLOY-FREE-TIER.md.
frontend-react/dist/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Docker
*.log

# Prerender SSR bundle (build intermediate, see frontend-react/scripts/prerender.mjs)
frontend-react/.prerender-ssr/
