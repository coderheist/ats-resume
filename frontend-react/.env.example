# All optional -- the app runs fine with none of these set (Firebase Auth
# just stays "not configured", and every auth-dependent UI piece degrades
# to an honest state instead of crashing; see lib/firebase.js).

# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# (or "Add app" if none exists yet) -- these four values come from there.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Enabling sign-in methods (Firebase Console -> Authentication ->
# Sign-in method). Setting the four values above is NOT sufficient on its
# own -- every provider you intend to offer has to be enabled explicitly
# in the console, and none of them are on by default:
#
#   Email/Password -> enable it. Without this, every email/password
#     sign-in and sign-up fails with auth/operation-not-allowed. Note
#     that only the Google popup error codes are translated into readable
#     messages today (lib/authContext.jsx), so an email/password failure
#     surfaces Firebase's raw code -- check this setting first.
#
#   Google -> add "Google" as a provider -> Save. Nothing to set here for
#     it; the code side (signInWithPopup + GoogleAuthProvider) is already
#     wired up in lib/authContext.jsx and just needs the provider enabled
#     on Firebase's side to work end to end.
#
# If Google sign-in still fails after enabling it, check Authentication ->
# Settings -> Authorized domains includes the domain this app is actually
# served from (Firebase only allows OAuth redirects back to domains
# explicitly listed there).

# Only needed if the backend isn't on the same origin / Vite's dev proxy
# doesn't apply (see vite.config.js) -- e.g. pointing a production build
# at a deployed backend.
VITE_API_BASE_URL=

# Deployed origin, e.g. https://yourdomain.com -- REQUIRED for any
# production build. Canonical URLs, og:url, og:image, sitemap.xml and
# robots.txt all derive from it (src/lib/seo.js, scripts/prerender.mjs).
#
# Left unset, the build still succeeds but stamps every page with the
# placeholder domain resume-optimizer.example.com. That is worse than
# having no canonical tag at all -- it tells search engines the real
# version of your content lives on a domain you don't own. The build
# prints a warning when this happens; treat it as a failure.
# Not needed for local dev.
VITE_SITE_URL=
