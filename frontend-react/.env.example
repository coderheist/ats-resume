# All optional -- the app runs fine with none of these set (Firebase Auth
# just stays "not configured", and every auth-dependent UI piece degrades
# to an honest state instead of crashing; see lib/firebase.js).

# Firebase Console -> Project Settings -> General -> Your apps -> Web app
# (or "Add app" if none exists yet) -- these four values come from there.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Google Sign-In specifically (email/password works with just the four
# values above once a Firebase project exists -- Google needs one more
# manual step): Firebase Console -> Authentication -> Sign-in method ->
# add "Google" as a provider -> Save. Nothing to set here for it; the
# code side (signInWithPopup + GoogleAuthProvider) is already wired up
# in lib/authContext.jsx and just needs the provider enabled on
# Firebase's side to work end to end. If Google sign-in still fails
# after enabling it, check Authentication -> Settings -> Authorized
# domains includes the domain this app is actually served from (Firebase
# only allows OAuth redirects back to domains explicitly listed there).

# Only needed if the backend isn't on the same origin / Vite's dev proxy
# doesn't apply (see vite.config.js) -- e.g. pointing a production build
# at a deployed backend.
VITE_API_BASE_URL=
