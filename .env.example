# Copy this file to .env and fill in what you need. .env is loaded
# automatically at process startup (app/main.py calls load_dotenv() before
# anything else) -- you do not need to `export` these in your shell.
# .env itself is git-ignored (see .gitignore); .env.example is the template
# that's safe to commit.
#
# Nothing here is required to run the app -- every value has a sensible
# default and every LLM-backed feature degrades gracefully (to a
# heuristic/template fallback) when its key is missing. Set only what you
# actually want to use.

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
# Any combination of these three may be set. Which one actually answers a
# given call depends on two independent things:
#
#   1. Per-request tier (POST /resume/parse-file, /resume/parse-text --
#      "tier": "basic"|"medium"|"advanced" -> Groq|Gemini|Claude). This
#      always wins when a tier is explicitly passed, regardless of
#      LLM_PROVIDER below.
#   2. LLM_PROVIDER (process-wide fallback default) -- used by every call
#      site that does NOT expose a tier (e.g. POST /score/suggestions'
#      use_llm:true, the voice agent's real generation path once wired up).
#
# See README.md's "Multi-provider LLM switching" section for the full
# picture, including exactly which pip package each provider needs.

# Claude -- the default LLM_PROVIDER if unset, and the "advanced" tier.
ANTHROPIC_API_KEY=

# Gemini -- the "medium" tier.
GEMINI_API_KEY=

# Groq -- the "basic" tier (fast/cheap, good for high-volume classification).
GROQ_API_KEY=

# Which provider LLM_PROVIDER-driven call sites use by default.
# One of: claude (default if unset) | gemini | groq
LLM_PROVIDER=claude

# ---------------------------------------------------------------------------
# Open-weight extraction crosscheck (app/core/llm/oss_extraction_client.py)
# ---------------------------------------------------------------------------
# Points at any OpenAI-compatible chat completions endpoint -- a self-hosted
# vLLM/SGLang server, or a hosted open-weight inference provider (this can
# also just be pointed at Groq's OpenAI-compatible endpoint). Independent of
# the tier selector above -- only used for TaskType.EXTRACTION_CROSSCHECK.
OSS_EXTRACTION_BASE_URL=
OSS_EXTRACTION_API_KEY=not-needed
OSS_EXTRACTION_MODEL=

# ---------------------------------------------------------------------------
# Embeddings (app/core/scoring/embeddings.py)
# ---------------------------------------------------------------------------
# Leave unset (or anything other than "sbert") to use the built-in TF-IDF
# fallback -- no extra install, works out of the box, but purely lexical
# (see README's "Note on the TF-IDF fallback's numbers"). Set to "sbert" and
# `pip install sentence-transformers` for real semantic embeddings -- this
# is also what makes requirement_matching.py's semantic-match code path
# actually fire in practice, not just exist.
EMBEDDING_BACKEND=

# ---------------------------------------------------------------------------
# Database (app/db/session.py)
# ---------------------------------------------------------------------------
# Defaults to a local SQLite file if unset -- fine for trying the app out.
# For anything beyond local experimentation, this app runs on Supabase's
# hosted Postgres (verified: migrations applied and the full test suite --
# 307 tests -- passes against a real Postgres 16 + pgvector 0.6 instance,
# not just SQLite).
#
# Supabase setup:
#   1. Create a project at supabase.com. In the SQL Editor, run:
#        create extension if not exists vector;
#      (enables pgvector for the Resume.embedding column -- see
#      infra/schema.sql; Supabase supports this extension natively).
#   2. Project Settings -> Database -> Connection string. Use the
#      "Session" pooler (port 5432 direct, or 6543 in session mode) --
#      NOT the "Transaction" pooler (6543 in transaction mode). This app
#      is a long-running FastAPI process (not serverless functions), and
#      SQLAlchemy's own connection pooling expects session-level features
#      (e.g. prepared statements) that pgbouncer's transaction mode
#      doesn't support -- using it can cause hard-to-diagnose intermittent
#      errors under load.
#   3. Append ?sslmode=require if it isn't already in the string Supabase
#      gives you -- Supabase requires SSL and some connection-string
#      variants omit this parameter by default.
#   4. Run `alembic upgrade head` once, pointed at that DATABASE_URL.
#
# Example (with a placeholder password/host -- use your own project's
# actual connection string from the dashboard, never commit the real one):
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# ---------------------------------------------------------------------------
# Firebase Auth (app/core/auth/firebase_auth.py)
# ---------------------------------------------------------------------------
# Genuinely optional: if unset, auth-dependent routes (/auth/me, /history)
# return a clear 503 rather than the app failing to start. The free
# scoring/analysis endpoints have never required an account and still don't.
#
# Setup: Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. That downloads a JSON file -- set this env var
# to its full CONTENT (not a file path), e.g. via `FIREBASE_SERVICE_ACCOUNT_JSON=$(cat key.json)`
# in your shell, or paste the JSON directly here for local dev (never commit
# the real value).
FIREBASE_SERVICE_ACCOUNT_JSON=

# ---------------------------------------------------------------------------
# Razorpay (app/core/billing/razorpay_client.py, app/api/routes/payments.py)
# ---------------------------------------------------------------------------
# Genuinely optional, same pattern as Firebase above: if unset, /payments/*
# routes return a clear 503 rather than the app failing to start. Every
# other endpoint (including the free scoring tools) is completely
# unaffected -- payments only gate upgrading a signed-in user's tier.
#
# Setup:
#   1. Create a Razorpay account at razorpay.com, complete KYC (required
#      before accepting real payments -- test mode works without it).
#   2. Dashboard -> Settings -> API Keys -> Generate Test/Live Key. That
#      gives you RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET.
#   3. Dashboard -> Settings -> Webhooks -> Add New Webhook, pointed at
#      https://your-domain/payments/webhook, subscribed to at least
#      payment.captured and payment.failed. That generates
#      RAZORPAY_WEBHOOK_SECRET (a DIFFERENT secret from key_secret --
#      the SDK verifies webhook payloads and payment callbacks with two
#      separate signatures, on purpose, since they protect against
#      different things).
#   4. This app defaults to USD pricing (app/config.py's Tier prices).
#      A brand-new Razorpay account is INR-only by default -- enabling
#      international currency processing is a separate dashboard/KYC
#      step (Settings -> Payment Methods -> International). If you'd
#      rather charge in INR only, convert config.py's prices and pass
#      currency="INR" from the frontend checkout call instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# CORS (app/main.py)
# ---------------------------------------------------------------------------
# Comma-separated list of origins allowed to call this API. Defaults to
# the frontend/ console's local dev origin (:5500) plus the React app's
# dev/preview ports (:5174/:5175). Widen this for a real deployment.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5174,http://localhost:5175
